# Build the shared recipes image on a CHTC build node and put it on /staging.
#   condor_submit build_image.sub -a "OUT_DIR = /staging/<user>/images"
#   (a rebuild:  ... -a "NAME = ckpt-recipes-v2.sif")
# Takes about 15-30 minutes. If CHTC doesn't run build jobs as batch jobs, use it interactively:
#   condor_submit -i build_image.sub     then:   bash build_image.sh /staging/<user>/images

# Where the finished image goes (on /staging), and its name. OSDF caches by name: new build, new name.
OUT_DIR              = /staging/<user>/images
NAME                 = ckpt-recipes-v1.sif

universe             = vanilla
executable           = build_image.sh
arguments            = $(OUT_DIR) $(NAME)
transfer_input_files = recipes.def, requirements.txt
# CHTC runs image builds on dedicated build nodes, which have /staging mounted.
+IsBuildJob          = true
requirements         = (HasCHTCStaging =?= true)
request_cpus         = 4
request_memory       = 16GB
# The base image, the build's temporary files and the finished image (~7 GB) all live in scratch.
request_disk         = 50GB
# Only the version list comes back here (the image itself goes to OUT_DIR).
transfer_output_files = versions.txt
log                  = build_image.log
output               = build_image.out
error                = build_image.err
queue
