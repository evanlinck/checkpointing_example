# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

# Output of running recipes and examples (checkpoints, job logs, test runs, container images)
checkpoints/
outputs/
hf_cache/
prepare.log
prepare.out
prepare.err
job.log
job.out
job.err
job_*.log
job_*.out
job_*.err
test_*_[0-9]*.log
test_*_[0-9]*.out
test_*_[0-9]*.err
test_*_[0-9]*.evicted/
test_*_[0-9]*.evicted.txt
test_*_[0-9]*.checkpoints/
test_*_[0-9]*.outputs/
*.sif

# Probe results: keep the human-readable summaries (cited by docs/environment.md);
# raw job files (job.out, job.log, ads, checkpoints) stay local.
results/**
!results/**/
!results/**/*.md
result_*.txt
*_run.txt

# Editor tooling bookkeeping
.cc-writes/

# Copies of the shared modules placed next to a recipe for job submission
recipes/*/htcondor_ckpt/

# Result files downloaded into a recipe directory for analysis
recipes/*/results/
