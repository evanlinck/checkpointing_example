# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

# Output of running recipes and examples (checkpoints, job logs, test runs, container images)
checkpoints/
outputs/
hf_cache/
prepare.log
prepare.out
prepare.err
job.log
job.out
job.err
job_*.log
job_*.out
job_*.err
test_*_[0-9]*.log
test_*_[0-9]*.out
test_*_[0-9]*.err
test_*_[0-9]*.evicted/
test_*_[0-9]*.evicted.txt
test_*_[0-9]*.checkpoints/
test_*_[0-9]*.outputs/
*.sif

# Probe results: keep the human-readable summaries (cited by docs/environment.md);
# raw job files (job.out, job.log, ads, checkpoints) stay local.
results/**
!results/**/
!results/**/*.md
result_*.txt
*_run*.txt
# Same rule for reports written inside probes/ (ap_survey.sh's raw .txt files hold job history
# and AP configuration; only summary.md is kept).
probes/results/**
!probes/results/**/
!probes/results/**/*.md

# Editor tooling bookkeeping
.cc-writes/

# probes/spool_check/: the job's own outputs (its log has IP addresses and host names)
probes/spool_check/ckpt/
probes/spool_check/spool_check.log
probes/spool_check/spool_check.out
probes/spool_check/spool_check.err

# Recipe 4: its data, the DAG's hand-off directory, per-test directories, DAGMan's files
recipes/04_ospool_lora/data/
recipes/04_ospool_lora/resume/
recipes/04_ospool_lora/test_*_[0-9]*/
*.dag.condor.sub
*.dag.dagman.*
*.dag.lib.*
*.dag.nodes.log
*.dag.rescue*
*.dag.metrics

# Copies of the shared modules placed next to a recipe for job submission
recipes/*/htcondor_ckpt/

# Result files downloaded into a recipe directory for analysis
recipes/*/results/

# containers/: the build job chtc-apptainer-build writes, and its logs
containers/apptainer-build.*
containers/*.log
containers/*.out
containers/*.err
