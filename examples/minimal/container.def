# Apptainer definition for recipe 0: Python 3.12 + CPU-only PyTorch + NumPy.
# Build it in a CHTC interactive build job, then copy the .sif to /staging:
#   apptainer build recipe0.sif container.def
# On a GPU, use a CUDA-enabled PyTorch image instead.
Bootstrap: docker
From: python:3.12-slim

%files
    requirements.txt /opt/requirements.txt

%post
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.8.0
    pip install --no-cache-dir -r /opt/requirements.txt
