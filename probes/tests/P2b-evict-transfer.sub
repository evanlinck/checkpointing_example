# P2b - Vacate in spool mode, on-sigterm=save85
# @question: Same as P2a, plus when_to_transfer_output = ON_EXIT_OR_EVICT. Is step B transferred on eviction? After a hard kill (-fast), where nothing can be transferred, does the job still restart from the spooled voluntary checkpoint A, or from scratch?
# @sites: chtc chtc_backfill ospool
# @triggers: vacate:150 vacate-fast:150 hold-release:150
# Timeline: voluntary checkpoint at step 60 (call it A), restart, keep running;
# trigger fires ~150 s after the first start (step ~140); on SIGTERM the probe
# behaves per --on-sigterm. On the next start, the restored step tells us what survived.
checkpoint_exit_code      = 85
transfer_checkpoint_files = ckpt
transfer_output_files     = ckpt, out
# Stream stdout so we can see the evicted execution's own log lines.
stream_output = true
stream_error  = true
when_to_transfer_output = ON_EXIT_OR_EVICT
arguments = $(PROBE_ARGS) --voluntary-exit-at 60 --on-sigterm save85 --total-steps 420
