# build.sub - interactive job for building the container images (CHTC build node).
# Usage on ap2002:   condor_submit -i build.sub     then:   bash setup.sh build [--with-torch]
# CONFIRM +IsBuildJob against CHTC's current "build a container" guide.
universe             = vanilla
+IsBuildJob          = true
requirements         = (HasCHTCStaging =?= true)
transfer_input_files = setup.sh, pytorch-cpu.def
request_cpus         = 4
request_memory       = 8GB
request_disk         = 16GB
log                  = build.log
queue
